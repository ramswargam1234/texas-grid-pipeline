# Copy to .env and fill in.
# Free EIA key (emailed instantly): https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# AWS (Phase 2): keys for the restricted IAM user, never the root account
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=

# Optional overrides
# DATA_DIR=data
# EIA_TYPES=D,DF,NG
